{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/igm/schemas/correctness-receipt.schema.json",
  "title": "IGM Phase 3C Correctness Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_contract",
    "optimization_contract",
    "numerical_profile",
    "graph_contract",
    "graph_sha256",
    "traversal_sha256",
    "layout_contract",
    "model_profile_sha256",
    "optimization_profile_sha256",
    "conformation_start",
    "conformation_count",
    "conformation_end_exclusive",
    "logical_pair_checks",
    "structured_distance_evaluations",
    "exact_z_residual_corrections",
    "diagnostic_xor_fnv1a64",
    "min_pair_distance_squared",
    "max_pair_distance_squared",
    "verification_samples",
    "verification_max_geometry_residual",
    "verification_max_pair_residual",
    "verification_tolerance",
    "verification_accepted",
    "result_sha256",
    "result_identity_worker_independent",
    "result_identity_chunk_independent",
    "inv_bio_001",
    "inv_runtime_001",
    "biological_validity_claimed",
    "clinical_validity_claimed"
  ],
  "properties": {
    "schema": {"const": "IGM-CAMPAIGN-CORRECTNESS-RECEIPT-V1"},
    "campaign_contract": {"const": "IGM-EXEC-CAMPAIGN-V1"},
    "optimization_contract": {"const": "IGM-PENTA-CRT-CPU-V1"},
    "numerical_profile": {"type": "string", "minLength": 1},
    "graph_contract": {"const": "IGM-EXEC-GRAPH-C5-K2-C3-V1"},
    "graph_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "traversal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "layout_contract": {"const": "IGM-WARP32-AOSOA-V1"},
    "model_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optimization_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "conformation_start": {"type": "integer", "minimum": 0},
    "conformation_count": {"type": "integer", "minimum": 1},
    "conformation_end_exclusive": {"type": "integer", "minimum": 1},
    "logical_pair_checks": {"type": "integer", "minimum": 1},
    "structured_distance_evaluations": {"type": "integer", "minimum": 1},
    "exact_z_residual_corrections": {"type": "integer", "minimum": 0},
    "diagnostic_xor_fnv1a64": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "min_pair_distance_squared": {"type": "number", "minimum": 0},
    "max_pair_distance_squared": {"type": "number", "minimum": 0},
    "verification_samples": {"type": "integer", "minimum": 1},
    "verification_max_geometry_residual": {"type": "number", "minimum": 0},
    "verification_max_pair_residual": {"type": "number", "minimum": 0},
    "verification_tolerance": {"type": "number", "exclusiveMinimum": 0},
    "verification_accepted": {"const": true},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_identity_worker_independent": {"const": true},
    "result_identity_chunk_independent": {"const": true},
    "inv_bio_001": {"const": "Perfect Mathematics Does Not Equal Perfect Biological Reality"},
    "inv_runtime_001": {"const": "Execution Adjacency Does Not Imply Biological Adjacency"},
    "biological_validity_claimed": {"const": false},
    "clinical_validity_claimed": {"const": false}
  }
}

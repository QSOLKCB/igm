{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/igm/schemas/campaign-manifest.schema.json",
  "title": "IGM Phase 3C Campaign Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_contract",
    "gate_contract",
    "gate_identity_sha256",
    "phase3c_gate_artifact_sha256",
    "validation_level",
    "validation_level_promoted_by_runtime",
    "correctness_result_sha256",
    "model_profile_sha256",
    "optimization_profile_sha256",
    "optimization_contract",
    "numerical_profile",
    "graph_contract",
    "layout_contract",
    "graph_sha256",
    "traversal_sha256",
    "requested_workers",
    "chunk_count",
    "artifacts",
    "manifest_sha256",
    "benchmark_identity_is_correctness_identity",
    "rejected"
  ],
  "properties": {
    "schema": {"const": "IGM-CAMPAIGN-MANIFEST-V2"},
    "campaign_contract": {"const": "IGM-EXEC-CAMPAIGN-V1"},
    "gate_contract": {"const": "IGM-PHASE3C-ACCEPTANCE-GATE-V1"},
    "gate_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "phase3c_gate_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_level": {"const": "V0"},
    "validation_level_promoted_by_runtime": {"const": false},
    "correctness_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optimization_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optimization_contract": {"const": "IGM-PENTA-CRT-CPU-V1"},
    "numerical_profile": {"const": "IGM-PENTA-CRT-F64-LUT-BLOCK-CIRCULANT-ZRESIDUAL-V1"},
    "graph_contract": {"const": "IGM-EXEC-GRAPH-C5-K2-C3-V1"},
    "layout_contract": {"const": "IGM-WARP32-AOSOA-V1"},
    "graph_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "traversal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_workers": {"type": "integer", "minimum": 1, "maximum": 256},
    "chunk_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "artifacts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "benchmark_identity_is_correctness_identity": {"const": false},
    "rejected": {"const": false}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/igm/schemas/phase3c-gate-receipt.schema.json",
  "title": "IGM Phase 3C Acceptance Gate Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gate_contract",
    "campaign_contract",
    "validation_level",
    "model_profile_sha256",
    "optimization_profile_sha256",
    "optimization_contract",
    "numerical_profile",
    "graph_contract",
    "layout_contract",
    "conformation_start",
    "conformation_count",
    "conformation_end_exclusive",
    "correctness_result_sha256",
    "profile_identity_preserved",
    "algorithm_identity_preserved",
    "phase3b_residual_gate_passed",
    "finite_and_bounded",
    "declared_slice_preserved",
    "correctness_identity_recomputed",
    "worker_independent_correctness_identity",
    "chunk_independent_correctness_identity",
    "benchmark_timing_excluded_from_correctness_identity",
    "correctness_identity_included_fields",
    "correctness_identity_excluded_fields",
    "implementation_structures_biological_relationships_claimed",
    "validation_level_promoted_by_runtime",
    "biological_validity_claimed",
    "clinical_validity_claimed",
    "inv_bio_001",
    "inv_runtime_001",
    "accepted",
    "gate_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "IGM-PHASE3C-GATE-RECEIPT-V1"},
    "gate_contract": {"const": "IGM-PHASE3C-ACCEPTANCE-GATE-V1"},
    "campaign_contract": {"const": "IGM-EXEC-CAMPAIGN-V1"},
    "validation_level": {"const": "V0"},
    "model_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optimization_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optimization_contract": {"const": "IGM-PENTA-CRT-CPU-V1"},
    "numerical_profile": {"const": "IGM-PENTA-CRT-F64-LUT-BLOCK-CIRCULANT-ZRESIDUAL-V1"},
    "graph_contract": {"const": "IGM-EXEC-GRAPH-C5-K2-C3-V1"},
    "layout_contract": {"const": "IGM-WARP32-AOSOA-V1"},
    "conformation_start": {"type": "integer", "minimum": 0},
    "conformation_count": {"type": "integer", "minimum": 1},
    "conformation_end_exclusive": {"type": "integer", "minimum": 1},
    "correctness_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_identity_preserved": {"const": true},
    "algorithm_identity_preserved": {"const": true},
    "phase3b_residual_gate_passed": {"const": true},
    "finite_and_bounded": {"const": true},
    "declared_slice_preserved": {"const": true},
    "correctness_identity_recomputed": {"const": true},
    "worker_independent_correctness_identity": {"const": true},
    "chunk_independent_correctness_identity": {"const": true},
    "benchmark_timing_excluded_from_correctness_identity": {"const": true},
    "correctness_identity_included_fields": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {"type": "string", "minLength": 1}
    },
    "correctness_identity_excluded_fields": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"type": "string", "minLength": 1}
    },
    "implementation_structures_biological_relationships_claimed": {"const": false},
    "validation_level_promoted_by_runtime": {"const": false},
    "biological_validity_claimed": {"const": false},
    "clinical_validity_claimed": {"const": false},
    "inv_bio_001": {"const": "Perfect Mathematics Does Not Equal Perfect Biological Reality"},
    "inv_runtime_001": {"const": "Execution Adjacency Does Not Imply Biological Adjacency"},
    "accepted": {"const": true},
    "gate_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

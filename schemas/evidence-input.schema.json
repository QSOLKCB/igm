{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/igm/schemas/evidence-input.schema.json",
  "title": "IGM Evidence Adapter Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "adapter_id",
    "observation_id",
    "source_id",
    "support_statement",
    "target",
    "derivation",
    "uncertainty",
    "snapshot"
  ],
  "properties": {
    "schema": {"const": "IGM-EVIDENCE-INPUT-V1"},
    "adapter_id": {
      "enum": [
        "IGM-CRYO-EM-PARAMETER-ADAPTER-V1",
        "IGM-MD-TRAJECTORY-ADAPTER-V1",
        "IGM-BIOCHEMICAL-CALIBRATION-ADAPTER-V1"
      ]
    },
    "observation_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
    "source_id": {"type": "string", "minLength": 1},
    "support_statement": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["parameter", "constraint"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "value": {},
    "unit": {"type": ["string", "null"]},
    "derivation": {"enum": ["direct", "transformed", "calibrated", "inferred", "assumed", "unknown"]},
    "uncertainty": {"$ref": "#/$defs/uncertainty"},
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["unknown", "interval", "standard-deviation", "confidence-interval", "source-reported"]},
        "lower": {"type": ["number", "integer", "null"]},
        "upper": {"type": ["number", "integer", "null"]},
        "value": {"type": ["number", "integer", "null"], "minimum": 0},
        "level": {"type": ["number", "integer", "null"], "minimum": 0, "maximum": 1},
        "unit": {"type": ["string", "null"]},
        "notes": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["unknown", "source-reported"]}}, "required": ["kind"]},
          "then": {"required": ["notes"]}
        },
        {
          "if": {"properties": {"kind": {"enum": ["interval", "confidence-interval"]}}, "required": ["kind"]},
          "then": {"required": ["lower", "upper"]}
        },
        {
          "if": {"properties": {"kind": {"const": "standard-deviation"}}, "required": ["kind"]},
          "then": {"required": ["value"]}
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "external_payload_committed", "redistribution_permission_verified"],
      "properties": {
        "mode": {"enum": ["reference-only", "hash-only", "packaged"]},
        "external_payload_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "external_payload_path": {"type": ["string", "null"], "minLength": 1},
        "external_payload_committed": {"type": "boolean"},
        "redistribution_permission_verified": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "packaged"}}, "required": ["mode"]},
          "then": {"required": ["external_payload_sha256", "external_payload_path"]}
        }
      ]
    }
  }
}
